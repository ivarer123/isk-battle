  "components": {
    "schemas": {
      "Cadence": {
        "enum": [
          "Daily",
          "Weekly",
          "Monthly",
          null
        ]
      },
      "CheckInRequest": {
        "required": [
          "ytdPercent",
          "confirmed"
        ],
        "type": "object",
        "properties": {
          "ytdPercent": {
            "type": "number",
            "format": "double"
          },
          "confirmed": {
            "type": "boolean"
          }
        }
      },
      "CheckInResponse": {
        "required": [
          "forDate",
          "ytdPercent"
        ],
        "type": "object",
        "properties": {
          "forDate": {
            "type": "string",
            "format": "date"
          },
          "ytdPercent": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CheckInWindowResponse": {
        "required": [
          "tradingDay",
          "closesAt"
        ],
        "type": "object",
        "properties": {
          "tradingDay": {
            "type": "string",
            "format": "date"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CheckoutResponse": {
        "required": [
          "checkoutUrl"
        ],
        "type": "object",
        "properties": {
          "checkoutUrl": {
            "type": "string"
          }
        }
      },
      "CreateLeagueRequest": {
        "required": [
          "name",
          "cadence"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cadence": {
            "$ref": "#/components/schemas/Cadence"
          }
        }
      },
      "JoinLeagueRequest": {
        "required": [
          "inviteCode"
        ],
        "type": "object",
        "properties": {
          "inviteCode": {
            "type": "string"
          }
        }
      },
      "JoinLeagueResponse": {
        "required": [
          "leagueId",
          "leagueName",
          "status",
          "alreadyMember"
        ],
        "type": "object",
        "properties": {
          "leagueId": {
            "type": "string",
            "format": "uuid"
          },
          "leagueName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          },
          "alreadyMember": {
            "type": "boolean"
          }
        }
      },
      "LeagueDetail": {
        "required": [
          "id",
          "name",
          "cadence",
          "nextSeasonCadence",
          "tier",
          "capacity",
          "activeMemberCount",
          "pendingMemberCount",
          "myRole",
          "myStatus",
          "inviteCode",
          "periods",
          "members",
          "upgradeOptions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "cadence": {
            "$ref": "#/components/schemas/Cadence"
          },
          "nextSeasonCadence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Cadence"
              }
            ]
          },
          "tier": {
            "$ref": "#/components/schemas/LeagueTier"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "activeMemberCount": {
            "type": "integer",
            "format": "int32"
          },
          "pendingMemberCount": {
            "type": "integer",
            "format": "int32"
          },
          "myRole": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "myStatus": {
            "$ref": "#/components/schemas/MemberStatus"
          },
          "inviteCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "periods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodType"
            }
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeagueMemberResponse"
            }
          },
          "upgradeOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpgradeOption"
            }
          }
        }
      },
      "LeagueMemberResponse": {
        "required": [
          "userId",
          "displayName",
          "role",
          "status"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          }
        }
      },
      "LeagueSummary": {
        "required": [
          "id",
          "name",
          "cadence",
          "tier",
          "myRole",
          "myStatus",
          "activeMemberCount",
          "capacity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "cadence": {
            "$ref": "#/components/schemas/Cadence"
          },
          "tier": {
            "$ref": "#/components/schemas/LeagueTier"
          },
          "myRole": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "myStatus": {
            "$ref": "#/components/schemas/MemberStatus"
          },
          "activeMemberCount": {
            "type": "integer",
            "format": "int32"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LeagueTier": {
        "enum": [
          "Free",
          "Premium50",
          "Premium100",
          "Premium250"
        ]
      },
      "MemberRole": {
        "enum": [
          "Owner",
          "CoHost",
          "Member"
        ]
      },
      "MemberStatus": {
        "enum": [
          "Active",
          "Pending"
        ]
      },
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "email",
          "emailRemindersEnabled",
          "effectiveCadence",
          "today",
          "lastCheckIn",
          "openWindow",
          "nextWindowOpensAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailRemindersEnabled": {
            "type": "boolean"
          },
          "effectiveCadence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Cadence"
              }
            ]
          },
          "today": {
            "type": "string",
            "format": "date"
          },
          "lastCheckIn": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CheckInResponse"
              }
            ]
          },
          "openWindow": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CheckInWindowResponse"
              }
            ]
          },
          "nextWindowOpensAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PeriodResponse": {
        "required": [
          "type",
          "start",
          "end",
          "season",
          "isoWeek"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/PeriodType"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "season": {
            "type": "integer",
            "format": "int32"
          },
          "isoWeek": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "PeriodType": {
        "enum": [
          "Day",
          "Week",
          "Month",
          "Year"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StandingsResponse": {
        "required": [
          "period",
          "rows"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/PeriodResponse"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandingsRowResponse"
            }
          }
        }
      },
      "StandingsRowResponse": {
        "required": [
          "userId",
          "displayName",
          "status",
          "rank",
          "periodReturn",
          "ytdPercent",
          "isMe"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/StandingStatus"
          },
          "rank": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "periodReturn": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "ytdPercent": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "isMe": {
            "type": "boolean"
          }
        }
      },
      "StandingStatus": {
        "enum": [
          "Ranked",
          "Ny",
          "Pausad"
        ]
      },
      "StartCheckoutRequest": {
        "required": [
          "targetTier",
          "immediateDeliveryConsent"
        ],
        "type": "object",
        "properties": {
          "targetTier": {
            "$ref": "#/components/schemas/LeagueTier"
          },
          "immediateDeliveryConsent": {
            "type": "boolean"
          }
        }
      },
      "UpdateLeagueRequest": {
        "required": [
          "name",
          "nextSeasonCadence"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "nextSeasonCadence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Cadence"
              }
            ]
          }
        }
      },
      "UpdateMeRequest": {
        "required": [
          "displayName",
          "emailRemindersEnabled"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "emailRemindersEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "UpgradeOption": {
        "required": [
          "tier",
          "capacity",
          "priceOre"
        ],
        "type": "object",
        "properties": {
          "tier": {
            "$ref": "#/components/schemas/LeagueTier"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "priceOre": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "MeEndpoints"
    },
    {
      "name": "CheckInEndpoints"
    },
    {
      "name": "LeagueEndpoints"
    },
    {
      "name": "PaymentEndpoints"
    }
  ]
}